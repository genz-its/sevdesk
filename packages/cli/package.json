  },
  "bugs": {
    "url": "https://github.com/mi-skam/sevdesk/issues"
  },
  "keywords": [
    "sevdesk",
    "api",
    "cli",
    "accounting",
    "bookkeeping"
  ],
  "author": "Robin Genz <mail@genz-its.de>",
