    "test:terminal": "python3 test/quotes-terminal.test.py"
  },
  "dependencies": {
    "@genz-its/sevdesk-sdk": "0.2.0",
    "consola": "3.4.2",
    "decimal.js": "10.6.0",
    "zod": "4.6.7",
    "zodline": "0.3.0"
  },
  "homepage": "https://github.com/mi-skam/sevdesk",
  "repository": {
